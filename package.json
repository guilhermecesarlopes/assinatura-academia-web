{
  "name": "assinatura-academia-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@assinatura-academia/contracts": "github:guilhermecesarlopes/assinatura-academia-api#path:/packages/contracts",
    "@opennextjs/cloudflare": "^1.20.10",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.149.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "@node-minify/core>glob": "^10.5.0"
    }
  }
}
